{
  "manifest_version": 3,
  "name": "SGO DXN Capture - COMAS",
  "version": "0.2.1",
  "description": "Envía capturas de ventas y resúmenes de DXN OBS al SGO de COMAS.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://obs6.dxn2u.com/*",
    "http://192.168.18.47:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://obs6.dxn2u.com/*"
      ],
      "js": [
        "content-dxn.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://192.168.18.47:8080/*"
      ],
      "js": [
        "content-sgo.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SGO DXN Capture - COMAS"
  }
}