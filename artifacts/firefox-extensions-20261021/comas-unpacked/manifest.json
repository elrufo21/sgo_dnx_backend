{
  "manifest_version": 3,
  "name": "SGO DXN Capture - Producción",
  "version": "0.2.0",
  "description": "Envía capturas de DXN OBS al SGO de producción.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://obs6.dxn2u.com/*",
    "http://192.168.18.47:8080/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://obs6.dxn2u.com/*"
      ],
      "js": [
        "content-dxn.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://192.168.18.47:8080/*"
      ],
      "js": [
        "content-sgo.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SGO DXN Capture - Producción"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sgo-dxn-capture-comas@dxnventas.local",
      "data_collection_permissions": {
        "required": [
          "financialAndPaymentInfo",
          "personallyIdentifyingInfo",
          "websiteContent"
        ]
      }
    }
  }
}
