{
  "manifest_version": 3,
  "name": "SGO DXN Capture - Desarrollo",
  "version": "0.2.0",
  "description": "Envía capturas de DXN OBS al SGO local de desarrollo.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://obs6.dxn2u.com/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://obs6.dxn2u.com/*"],
      "js": ["content-dxn.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*"
      ],
      "js": ["content-sgo.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SGO DXN Capture - Desarrollo"
  }
}
