{
    "manifest_version":  3,
    "name":  "SGO DXN Capture - COMAS",
    "version":  "0.2.1",
    "description":  "Captura ventas y resumenes de DXN OBS para SGO COMAS.",
    "permissions":  [
                        "storage",
                        "tabs",
                        "scripting"
                    ],
    "host_permissions":  [
                             "https://obs6.dxn2u.com/*",
                             "http://192.168.18.47/*"
                         ],
    "background":  {
                       "scripts":  [
                                       "background.js"
                                   ]
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://obs6.dxn2u.com/*"
                                            ],
                                "js":  [
                                           "content-dxn.js"
                                       ],
                                "all_frames":  true,
                                "run_at":  "document_idle",
                                "include_globs":  [
                                                      "https://obs6.dxn2u.com/*"
                                                  ]
                            },
                            {
                                "matches":  [
                                                "http://192.168.18.47/*"
                                            ],
                                "js":  [
                                           "content-sgo.js"
                                       ],
                                "run_at":  "document_idle",
                                "include_globs":  [
                                                      "http://192.168.18.47:8080/*"
                                                  ]
                            }
                        ],
    "action":  {
                   "default_title":  "SGO DXN Capture - COMAS"
               },
    "browser_specific_settings":  {
                                      "gecko":  {
                                                    "id":  "sgo-dxn-capture-comas@dxnventas.local",
                                                    "data_collection_permissions":  {
                                                                                        "required":  [
                                                                                                         "financialAndPaymentInfo",
                                                                                                         "personallyIdentifyingInfo",
                                                                                                         "websiteContent"
                                                                                                     ]
                                                                                    }
                                                }
                                  }
}